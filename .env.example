# ─────────────────────────────
# Runtime
# ─────────────────────────────
ENV=local
DEBUG=true
API_BASE=/v1

# ─────────────────────────────
# Auth (optional)
# ─────────────────────────────
AUTH_ENABLED=false
API_TOKEN=dev-token

# ─────────────────────────────
# CORS
# Note: keep this as a JSON array so Pydantic parses it into a List[str]
# ─────────────────────────────
ALLOW_ALL_CORS=false
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# ─────────────────────────────
# Storage / Uploads
# ─────────────────────────────
# Can be absolute or relative to backend root
STORAGE_DIR=data/uploads
MAX_UPLOAD_MB=20

# ─────────────────────────────
# Retention (housekeeping)
# ─────────────────────────────
ENABLE_RETENTION=true
RETENTION_DAYS=7
RETENTION_SWEEP_MINUTES=30

# ─────────────────────────────
# Outline / Agent (model calling)
# If using Runpod, point AGENT_URL to your Runpod endpoint:
#   e.g. https://api.runpod.ai/v2/<endpointId>/run
# Provide either AGENT_API_KEY or RUNPOD_API_KEY.
# ─────────────────────────────
FEATURE_USE_MODEL=true
AGENT_URL=https://api.runpod.ai/v2/REPLACE_WITH_ENDPOINT_ID/run
AGENT_API_KEY=
AGENT_TIMEOUT_MS=10000

# Runpod options used by the strategy
RUNPOD_INPUT_MODE=wrap        # "wrap" | "passthrough"
RUNPOD_API_KEY=               # optional; used if AGENT_API_KEY not set

# ─────────────────────────────
# Image enrichment / generation
# IMAGE_PROVIDER: "stub" | "pexels" | "openai" | "gpt" | "gpt-image"
# ─────────────────────────────
FEATURE_IMAGE_API=true
IMAGE_PROVIDER=pexels
PEXELS_API_KEY=               # required if IMAGE_PROVIDER=pexels

OPENAI_API_KEY=               # required if IMAGE_PROVIDER=openai/gpt/gpt-image
IMAGE_OPENAI_MODEL=gpt-image-1
IMAGE_OPENAI_STYLE=           # optional: "photo" | "illustration" | "diagram" | "icon"

# ─────────────────────────────
# Figures extraction (pdffigures2)
# If you don't have pdffigures2 installed, set USE_PDFFIGURES2=false
# ─────────────────────────────
USE_PDFFIGURES2=false
PDFFIGURES2_BIN=/usr/local/bin/pdffigures2

# ─────────────────────────────
# Observability
# ─────────────────────────────
TIMING_ALLOW_ORIGIN=*

# ─────────────────────────────
# Parsing (GROBID)
# If you’re running via docker-compose, default is http://grobid:8070
# ─────────────────────────────
GROBID_ENABLED=true
GROBID_URL=http://grobid:8070
GROBID_TIMEOUT=30
